# Reclaim developer portal: https://dev.reclaimprotocol.org/ (create an app, copy both values)
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=

# Invoice proof (prove:invoice). Never commit real values.
# INVOICE_URL is the billing/invoice JSON endpoint you found on the provider.
INVOICE_URL=
# One of these, depending on how the provider authenticates:
INVOICE_AUTH_HEADER=
INVOICE_COOKIE=

# Operator revenue proof (prove:revenue). TEST-mode keys only, never live ones.
# Razorpay (default): dashboard.razorpay.com > Account & Settings > API Keys > Generate Test Key.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Stripe (optional, prove:revenue stripe): a restricted key with "Payouts: Read".
STRIPE_KEY=

# Loan terms for npm run loan:open (demo values for one ₹1,50,000 test payment).
LOAN_DEBT_SERVICE=120000
LOAN_COVENANT_WEEKS=1
# LOAN_MIN_COVERAGE=1.15
# LOAN_FUND_SOL=1
# PCT_ATTESTORS=0x...   (optional; defaults to Reclaim's live attestor list)
