# Reclaim developer portal: https://dev.reclaimprotocol.org/ (create an app, copy both values)
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=

# Invoice proof (prove:invoice). Never commit real values.
# INVOICE_URL is the billing/invoice JSON endpoint you found on the provider.
INVOICE_URL=
# One of these, depending on how the provider authenticates:
INVOICE_AUTH_HEADER=
INVOICE_COOKIE=
